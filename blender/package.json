{
  "name": "pithagoras-blender",
  "version": "0.1.0",
  "description": "Blender for Pithagoras: a headless Blender 5.2 with GPU rendering run in a container through Docker, its tools in every chat, and its live viewport in a panel beside the chat",
  "type": "module",
  "keywords": ["pi-package", "pithagoras", "blender"],
  "homepage": "https://github.com/thecodacus/pithagoras-flair/tree/main/blender",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thecodacus/pithagoras-flair.git",
    "directory": "blender"
  },
  "pi": {},
  "pithagoras": {
    "client": "./web/client.js",
    "style": "./web/client.css",
    "server": "./server.js",
    "requires": { "pithagoras-docker": "^1.2.0" }
  },
  "files": ["web", "server.js", "viewer.html", "README.md", "NOTICE", "LICENSE"],
  "scripts": {
    "build": "node build.mjs && tsc --noEmit -p .",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.mts",
    "test:portal": "node --import tsx --test --test-timeout=120000 test/portal/*.test.mts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "react-icons": "5.7.0"
  },
  "license": "Apache-2.0"
}
