{
  "name": "pithagoras-godot",
  "version": "0.1.0",
  "description": "Godot for Pithagoras: the real Godot 4.7 editor on the GPU, run in a container through Docker, streamed into a panel beside the chat, with its tools in every chat",
  "type": "module",
  "keywords": ["pi-package", "pithagoras", "godot", "game-engine", "mcp"],
  "homepage": "https://github.com/prometheion/pithagoras-extensions/tree/main/godot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prometheion/pithagoras-extensions.git",
    "directory": "godot"
  },
  "bugs": {
    "url": "https://github.com/prometheion/pithagoras-extensions/issues"
  },
  "pi": {},
  "pithagoras": {
    "client": "./web/client.js",
    "style": "./web/client.css",
    "server": "./lib/server.js",
    "requires": { "pithagoras-docker": "^1.2.0" }
  },
  "files": ["web", "lib", "pages", "README.md", "NOTICE", "LICENSE"],
  "scripts": {
    "build": "node build.mjs && tsc --noEmit -p .",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.mts",
    "test:portal": "node --import tsx --test --test-timeout=120000 test/portal/*.test.mts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "react-icons": "5.7.0"
  },
  "license": "Apache-2.0"
}
