{
  "name": "@pithagoras/inline-ui",
  "version": "0.1.0",
  "description": "Inline UI for Pithagoras: the agent shows the person an interactive card of its own HTML in the chat, sandboxed and with no network, and what the person does in it comes back to the agent as events",
  "type": "module",
  "keywords": ["pi-package", "pithagoras", "ui", "generative-ui", "interactive"],
  "homepage": "https://github.com/prometheion/pithagoras-extensions/tree/main/inline-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prometheion/pithagoras-extensions.git",
    "directory": "inline-ui"
  },
  "bugs": {
    "url": "https://github.com/prometheion/pithagoras-extensions/issues"
  },
  "pi": {},
  "pithagoras": {
    "client": "./web/client.js",
    "style": "./web/client.css",
    "server": "./server.js"
  },
  "files": ["web", "server.js", "README.md", "NOTICE", "LICENSE"],
  "scripts": {
    "build": "node build.mjs && tsc --noEmit -p .",
    "test": "node --import tsx --test --test-timeout=60000 test/*.test.mts && playwright test -c test/browser",
    "test:portal": "node --import tsx --test --test-timeout=120000 test/portal/*.test.mts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "react-icons": "5.7.0"
  },
  "publishConfig": { "access": "public" },
  "license": "Apache-2.0"
}
